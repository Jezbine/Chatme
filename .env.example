# Supabase — S1 fix: ne jamais commit de vraie clé prod
# Passer via --dart-define en CI/CD : --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_PUBLISHABLE_KEY=...
# Valeurs ci-dessous = défaut dev (celle du projet actuel) — à rotater après audit
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_ici
# SUPABASE_ANON_KEY alias (compat)
# Ne JAMAIS mettre SUPABASE_SERVICE_ROLE_KEY côté client

# Firebase (via flutterfire configure, génère lib/firebase_options.dart)
# FIREBASE_PROJECT_ID=chatme-benin

# FedaPay (passé via --dart-define, voir README)
# FEDA_API_KEY=sk_live_xxx
# FEDA_ENV=live

# LiveKit (passé via --dart-define)
# LIVEKIT_URL=wss://votre-projet.livekit.cloud
